# Cấu hình mẫu. .env local được script demo sinh riêng; không chứa credential thật tại đây.
DB_HOST=127.0.0.1
DB_PORT=3306
DB_NAME=quan_net_btl2
DB_USER=quan_net_app
DB_PASSWORD=
DB_TIME_ZONE=+07:00
DB_ISOLATION_LEVEL=READ COMMITTED
APP_TIMEZONE=Asia/Ho_Chi_Minh
BACKEND_HOST=127.0.0.1
BACKEND_PORT=5000
FRONTEND_API_BASE_URL=/api/v1
# TD đọc cấu hình môi trường; tự sinh khóa bí mật cho máy chạy, không commit.
SECRET_KEY=
SESSION_COOKIE_SECURE=false

# Chỉ cần cho compose/demo tự cài. Không dùng tài khoản này trong runtime API.
MYSQL_ROOT_PASSWORD=
DB_OWNER_USER=quan_net_owner
DB_OWNER_PASSWORD=
